# vivo Xplay6 (PD1610) device product definition
# Values measured on the real device, Android 7.1.1 / NMF26F / msm8996.

$(call inherit-product, $(SRC_TARGET_DIR)/product/full_base_telephony.mk)
$(call inherit-product, frameworks/native/build/phone-xhdpi-2048-dalvik-heap.mk)

PRODUCT_BRAND := vivo
PRODUCT_MANUFACTURER := vivo
PRODUCT_MODEL := vivo Xplay6
PRODUCT_NAME := lineage_pd1610
PRODUCT_DEVICE := pd1610
PRODUCT_RELEASE_NAME := PD1610
TARGET_DEVICE := PD1610

PRODUCT_BUILD_PROP_OVERRIDES += \
    PRIVATE_BUILD_DESC="PD1610-user 7.1.1 NMF26F release-keys" \
    BUILD_FINGERPRINT="vivo/PD1610/PD1610:7.1.1/NMF26F/compil02221630:user/release-keys"

PRODUCT_PROPERTY_OVERRIDES += \
    ro.sf.lcd_density=640 \
    ro.opengles.version=196610 \
    ro.hardware=qcom \
    ro.board.platform=msm8996

# This is a pre-Treble device: init.rc symlinks /vendor -> /system/vendor
# and there is NO independent vendor partition (verified in GPT + init.rc).
# All proprietary blobs therefore have to be baked into system.img.
PRODUCT_COPY_FILES += \
    $(DEVICE_PATH)/rootdir/fstab.qcom:root/fstab.qcom \
    $(DEVICE_PATH)/rootdir/init.qcom.rc:root/init.qcom.rc

# Proprietary blobs live in vendor/vivo/pd1610, produced by extract-files.sh
$(call inherit-product-if-exists, vendor/vivo/pd1610/pd1610-vendor.mk)

# Camera / fingerprint / audio / RIL HALs observed on the device:
#   lib64/hw/fingerprint.qcom.so, gatekeeper.msm8996.so,
#   keystore.msm8996.so, vulkan.msm8996.so,
#   activity_recognition.msm8996.so, sound_trigger.primary.msm8996.so,
#   flp.default.so
# Their full list (1609 files) is in vendor_all.txt; the trimmed list is in
# proprietary-files.txt. Add PRODUCT_PACKAGES entries once the vendor tree
# has been generated by extract-files.sh / setup-makefiles.sh.

PRODUCT_PACKAGES += \
    libril \
    libxml2

# NOTE: do NOT set PRODUCT_SUPPORTS_VERITY / BOARD_AVB_ENABLE here.
# The blocker is the STOCK boot, which enforces dm-verity (wait,verify).
# See BoardConfig.mk and build.sh for the flashing prerequisites.
